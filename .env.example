# Postgres (optional — omit for in-memory demo mode)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cue

# Stripe test mode (optional — omit both to mock PaymentIntents in development)
# Get keys from https://dashboard.stripe.com/test/apikeys
# sk_test_… is server-only; pk_test_… is safe for the browser (NEXT_PUBLIC_).
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional: for POST /api/v1/webhooks/stripe local forwarding
STRIPE_WEBHOOK_SECRET=whsec_...
# This app refuses live Stripe keys (sk_live_/rk_live_/pk_live_) by default.
# Only set ALLOW_STRIPE_LIVE=true after D'Arcy has explicitly approved going live.
# ALLOW_STRIPE_LIVE=true

# Stripe Connect — OFF unless BOTH STRIPE_PLATFORM_SECRET_KEY and
# STRIPE_CONNECTED_ACCOUNT_ID are set. Honeycomb's Stripe account is the
# platform; the SPP/Cue account is the connected account. Every PaymentIntent
# becomes a direct charge on the connected account (Stripe-Account header)
# with application_fee_amount = round(APPLICATION_FEE_BPS of the charge).
# When on, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY must be the PLATFORM's pk_test_.
# Test keys only (live keys are refused unless ALLOW_STRIPE_LIVE=true).
# STRIPE_PLATFORM_SECRET_KEY=sk_test_...
# STRIPE_CONNECTED_ACCOUNT_ID=acct_...
# NEXT_PUBLIC_STRIPE_CONNECTED_ACCOUNT_ID=acct_...   # same value; used by the Payment Element
# APPLICATION_FEE_BPS=1000          # 1000 = 10% (default)
# APPLICATION_FEE_ROOM_ONLY=false   # true = fee on room time only (no parking/add-ons)
# Signing secret of the platform's Connect webhook endpoint ("Events on connected accounts").
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# Notification "to" address for new-booking host emails (not an auth gate —
# see staff sign-in below for /host and /api/v1/host/* access)
HOST_EMAIL=host@example.com

# SMTP — optional. When ALL five of these are set, lib/email.ts sends real
# email (booking requested/confirmed/reminder, host new-request, contact
# form) via nodemailer; otherwise it falls back to logging to the console.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Cue <noreply@thecue.work>"

# "To" address for the room-page contact form (app/api/contact/route.ts).
# Defaults to darcy@thecue.work if unset.
# CONTACT_EMAIL=darcy@thecue.work

# Staff sign-in — signs the staff session cookie. Required in production;
# falls back to a random per-process value in development.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Used only by `npm run staff:create` (scripts/create-staff-user.ts) to provision/update
# one staff account. Not read by the app itself, and never set in committed env files.
# STAFF_EMAIL=
# STAFF_NAME=
# STAFF_PASSWORD=

# Protects POST /api/v1/internal/expire-requests (cron target that auto-declines
# booking requests past their 24h host response window and releases the hold).
# Required for that route to work; sent back as `Authorization: Bearer <CRON_SECRET>`.
# Not needed for `npm run bookings:expire` (runs the same logic directly, no HTTP).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pricing feature flags — all default off; see docs/REMOVED_FEATURES.md
# PRICING_ENABLE_LONG_BOOKING_DISCOUNT=true
# PRICING_ENABLE_OVERTIME=true
# PRICING_ENABLE_PARKING_ADDON=true

# Google Calendar sync — disabled/mock/live (default: disabled)
# Each room's calendar is a secondary calendar (c_…@group.calendar.google.com)
# owned by darcy@thecue.work, not a Calendar "resource". It must be shared with
# whichever identity authenticates below, with "Make changes to events".
# For reference, the 4 room calendar IDs (also in lib/seed.ts):
#   M1: c_e88039667398de2f9dd4f5b5c52147b034323e48620c7cb4c278eefcdc0601a6@group.calendar.google.com
#   M2: c_8b3363b1a13418a42df25d270780f453fa4f4e2de9be4b5d85bc3119ea23ff3a@group.calendar.google.com
#       (+ busy-only "M2 - SPP": c_4a620221db3b792706f2006543986fa6ba4de1b596798b2977daef22623147c9@group.calendar.google.com)
#   M3: c_fa24824eeb56172234a4e332185b1590926da705c57c76d6d99d3a164f696ba6@group.calendar.google.com
#   M4: c_44bb9580defceabfbb00be84aee1b13223c607efffc9051673f813a5e03a6152@group.calendar.google.com
# GOOGLE_CALENDAR_MODE=disabled

# Option A — service account (preferred for server-to-server sync):
# GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_CALENDAR_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
# Optional — domain-wide delegation subject to impersonate:
# GOOGLE_CALENDAR_IMPERSONATE_SUBJECT=darcy@thecue.work

# Option B — OAuth refresh token (alternative to a service account):
# GOOGLE_CALENDAR_CLIENT_ID=...
# GOOGLE_CALENDAR_CLIENT_SECRET=...
# GOOGLE_CALENDAR_REFRESH_TOKEN=...

# Dev-only: seed mock busy windows when GOOGLE_CALENDAR_MODE=mock.
# JSON shape: {"<calendarId>":[{"start":"2026-01-05T15:00:00.000Z","end":"2026-01-05T17:00:00.000Z"}]}
# ({startsAt,endsAt} keys are also accepted as an alias for {start,end}.)
# GOOGLE_CALENDAR_MOCK_BUSY={}

# Guest Wi-Fi password, shown only in the confirmation/reminder emails (never on the site).
# CUE_WIFI_PASSWORD=

# Deployment flavor. Set CUE_APP_ENV=preview on the preview only: every outgoing
# email subject gets a "[PREVIEW] " prefix. Leave unset on live (no prefix).
# CUE_APP_ENV=preview
