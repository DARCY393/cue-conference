# Postgres (optional — omit for in-memory demo mode)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cue

# Stripe test mode (optional — omit both to mock PaymentIntents in development)
# Get keys from https://dashboard.stripe.com/test/apikeys
# sk_test_… is server-only; pk_test_… is safe for the browser (NEXT_PUBLIC_).
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional: for POST /api/v1/webhooks/stripe local forwarding
STRIPE_WEBHOOK_SECRET=whsec_...
# This app refuses live Stripe keys (sk_live_/rk_live_/pk_live_) by default.
# Only set ALLOW_STRIPE_LIVE=true after D'Arcy has explicitly approved going live.
# ALLOW_STRIPE_LIVE=true

# Host gate for /host and /api/v1/host/*
HOST_EMAIL=host@example.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pricing feature flags — all default off; see docs/REMOVED_FEATURES.md
# PRICING_ENABLE_LONG_BOOKING_DISCOUNT=true
# PRICING_ENABLE_OVERTIME=true
# PRICING_ENABLE_PARKING_ADDON=true
